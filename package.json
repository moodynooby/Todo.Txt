{
	"name": "todo.txt",
	"version": "1.0.1",
	"description": "A todo.txt-compatible plain text todo app built with React and Mantine",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build && node scripts/check-size.mjs",
		"preview": "vite preview",
		"lint": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write .",
		"check": "biome check --write . && tsc --noEmit",
		"tauri": "tauri",
		"test": "vitest run --dir src"
	},
	"dependencies": {
		"@excalidraw/excalidraw": "0.18.1",
		"@mantine/core": "^9.5.1",
		"@mantine/form": "^9.5.1",
		"@mantine/hooks": "^9.5.1",
		"@mantine/notifications": "^9.5.1",
		"@mantine/spotlight": "^9.5.1",
		"@mantine/tiptap": "^9.5.1",
		"@tiptap/core": "^3.30.2",
		"@tiptap/extension-placeholder": "^3.30.2",
		"@tiptap/extension-task-item": "^3.30.2",
		"@tiptap/extension-task-list": "^3.30.2",
		"@tiptap/markdown": "^3.30.2",
		"@tiptap/pm": "^3.30.2",
		"@tiptap/react": "^3.30.2",
		"@tiptap/starter-kit": "^3.30.2",
		"@todotxt/core": "file:native/core/npm-package",
		"firebase": "^12.18.0",
		"lucide-react": "^1.33.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@tauri-apps/cli": "^2.11.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.1.0",
		"jsdom": "^30.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.2.2",
		"vite-plugin-pwa": "^1.3.0",
		"vitest": "^4.1.11"
	}
}
