# Pre-built JS bundles (regenerated by `./gradlew :core:jsBrowserProductionWebpack`)
native/core/npm-package/
native/core/npm/dist/

# Kotlin JS store lock (auto-regenerated by gradle)
native/kotlin-js-store/yarn.lock

# Analysis / working notes (not part of the product)
native_app_analysis/

# Env files
.env*
!.env.example

# Node modules
node_modules
dist/
tsconfig.tsbuildinfo

# Netlify
.netlify
