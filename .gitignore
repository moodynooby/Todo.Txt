*.sw?

# --- OS Specific Files ---
.DS_Store
Thumbs.db

# --- Tauri and Rust specific exclusions ---
# Rust build artifacts and compiled binaries
src-tauri/target/

# Tauri auto-generated capabilities schema files
src-tauri/gen/schemas/

# Mobile build artifacts (if using Tauri v2 mobile features)
# Keep the native directories but ignore compiled outputs
src-tauri/gen/android/.gradle/
src-tauri/gen/android/build/
src-tauri/gen/android/app/build/
src-tauri/gen/apple/build/

# Machine-specific / auto-generated files (regenerated by `tauri android init`)
src-tauri/gen/android/local.properties
src-tauri/gen/android/tauri.settings.gradle
src-tauri/gen/android/gradle/gradle-daemon-jvm.properties
src-tauri/gen/android/buildSrc/.gradle/

# Compiled Rust .so symlinks into local src-tauri/target/
src-tauri/gen/android/app/src/main/jniLibs/
