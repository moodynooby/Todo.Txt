{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "Todo.Txt",
	"version": "1.0.1",
	"identifier": "net.todotxt.app",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"windows": [
			{
				"title": "Todo.Txt",
				"width": 1280,
				"height": 800,
				"minWidth": 360,
				"minHeight": 600,
				"resizable": true,
				"fullscreen": false,
				"label": "main"
			}
		],
		"security": {
			"csp": null
		},
		"withGlobalTauri": false
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"android": {
			"debugApplicationIdSuffix": ".debug"
		}
	},
	"plugins": {
		"deep-link": {
			"desktop": {
				"schemes": ["todotxt"]
			}
		}
	}
}
