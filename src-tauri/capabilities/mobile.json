{
	"$schema": "../gen/schemas/mobile-schema.json",
	"identifier": "mobile-capability",
	"platforms": ["android", "iOS"],
	"windows": ["main"],
	"permissions": [
		"core:default",
		"notification:default",
		"notification:allow-create-channel",
