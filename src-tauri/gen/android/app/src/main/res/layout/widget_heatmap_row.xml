<?xml version="1.0" encoding="utf-8"?>
<!-- One heatmap row: 12 week cells for a single weekday (Mon on the first
     row), oldest week on the left. Cells are tinted by completion via
     `cell_0..cell_11`. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <View android:id="@+id/cell_0" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_1" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_2" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_3" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_4" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_5" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_6" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_7" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_8" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_9" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_10" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:layout_marginEnd="2dp" android:background="@drawable/widget_background" />
    <View android:id="@+id/cell_11" android:layout_width="0dp" android:layout_height="16dp" android:layout_weight="1" android:background="@drawable/widget_background" />
</LinearLayout>
