<?xml version="1.0" encoding="utf-8"?>
<!-- Single habit row in the Week Grid widget: 7 day squares (filled via
     day_square_* ids), habit name, weekly counter (n/7), and a today-done
     checkbox. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/week_cells"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <View
            android:id="@+id/day_square_0"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_background" />
        <View
            android:id="@+id/day_square_1"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_background" />
        <View
            android:id="@+id/day_square_2"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_background" />
        <View
            android:id="@+id/day_square_3"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_background" />
        <View
            android:id="@+id/day_square_4"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_background" />
        <View
            android:id="@+id/day_square_5"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:layout_marginEnd="2dp"
            android:background="@drawable/widget_background" />
        <View
            android:id="@+id/day_square_6"
            android:layout_width="0dp"
            android:layout_height="14dp"
            android:layout_weight="1"
            android:background="@drawable/widget_background" />
    </LinearLayout>

    <TextView
        android:id="@+id/habit_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorPrimary"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/habit_week_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorSecondary" />

    <CheckBox
        android:id="@+id/habit_done"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
