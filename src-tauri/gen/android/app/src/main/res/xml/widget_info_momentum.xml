<?xml version="1.0" encoding="utf-8"?>
<!-- Momentum hero widget (2x1): one oversized metric — best streak,
     28-day average consistency, or today's progress — rotating on each
     refresh. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_momentum"
    android:minWidth="110dp"
    android:minHeight="55dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="55dp"
    android:maxResizeWidth="250dp"
    android:maxResizeHeight="120dp"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable|configuration_optional"
    android:description="@string/widget_momentum_description"
    android:previewLayout="@layout/widget_momentum" />
